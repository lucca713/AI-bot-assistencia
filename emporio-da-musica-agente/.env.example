# =============================================================================
# Copie este arquivo para .env e ajuste os valores.
# =============================================================================

# --- PostgreSQL --------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=sua_senha_aqui
DB_DATABASE=loja_musica
# Schema próprio do agente (as tabelas importadas em "public" não são tocadas)
DB_SCHEMA=emporio

# --- Modelo de linguagem -------------------------------------------------------
# gemini = API gratuita (padrão). Chave grátis em https://aistudio.google.com/apikey
# groq   = outra API gratuita (chave em https://console.groq.com/keys)
# ollama = modelo local, sem chave (instale o Ollama e use LLM_MODEL=qwen3:14b)
LLM_PROVIDER=gemini
# Cole aqui a chave do provedor (não precisa para o ollama)
LLM_API_KEY=
# Vazio = endereço padrão do provedor (só mude para outro serviço compatível com OpenAI)
LLM_BASE_URL=
# Modelo com suporte a ferramentas. Vazio = padrão do provedor
# (gemini: gemini-flash-lite-latest, groq: meta-llama/llama-4-scout-17b-16e-instruct, ollama: qwen3:14b).
LLM_MODEL=

# --- Ollama (LLM local) --------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
# Temperatura baixa = respostas consistentes (atendimento não é lugar de criatividade)
LLM_TEMPERATURE=0.2
# Janela de contexto em tokens. O padrão do Ollama é pequeno e cortaria o prompt.
LLM_NUM_CTX=16384
# Modo "pensar" (qwen3 e similares). true = decide melhor, mas responde mais devagar.
LLM_THINK=false
LLM_TIMEOUT_S=300
LLM_KEEP_ALIVE=30m

# --- Agente --------------------------------------------------------------------
# Máximo de rodadas modelo -> ferramenta por mensagem do cliente
AGENT_MAX_STEPS=6
# Quantas trocas anteriores da conversa vão para o contexto do modelo
HISTORY_MAX_TURNS=8

# --- Relógio simulado (opcional) ----------------------------------------------
# Os pedidos da base são de out/2025 a mar/2026. Para testar prazos de devolução
# e "loja aberta/fechada" de forma realista, simule uma data (horário de Campo Grande).
# Deixe vazio para usar a data/hora real.
SIMULATED_NOW=
# SIMULATED_NOW=2026-02-20T10:30
